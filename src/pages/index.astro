---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/posts';
import { withBase } from '../lib/urls';
import banner from '../assets/hero-welcome.png';

const posts = await getPublishedPosts();
const recent = posts.slice(0, 5);
---

<BaseLayout description="Programming, vintage computers, and videogames from Atomic Burn Sauce.">
  <section class="pixel-frame mb-10 overflow-hidden bg-ink-900">
    <Image
      src={banner}
      alt=""
      widths={[768, 1200]}
      sizes="(min-width: 768px) 768px, 100vw"
      class="pixelated w-full"
    />
  </section>

  <section class="mb-12 flex flex-col gap-5">
    <div
      class="flex items-center gap-3 font-terminal text-base uppercase text-muted"
    >
      <span class="h-2 w-2 bg-led shadow-[0_0_6px_var(--color-led)]"></span>
      8-bit blog online
    </div>

    <h1
      class="font-display text-xl leading-relaxed text-brand-400 glow-text sm:text-3xl sm:leading-relaxed"
    >
      ATOMIC BURN SAUCE
    </h1>

    <p class="max-w-prose text-cream-300">
      Programming, vintage computers, and videogames. Notes from the workbench,
      the arcade, and the command line.
    </p>

    <div class="flex flex-wrap gap-3">
      <a
        href={withBase('/blog/')}
        class="inline-block border-2 border-brand-600 bg-ink-900 px-4 py-2 font-display text-[10px] uppercase tracking-widest text-sun transition-colors hover:bg-brand-600 hover:text-ink-950"
      >
        &gt; PRESS START
      </a>
      <a
        href={withBase('/rss.xml')}
        class="inline-block border-2 border-wood-600 bg-ink-900 px-4 py-2 font-display text-[10px] uppercase tracking-widest text-cream-300 transition-colors hover:border-sun hover:text-sun"
      >
        &gt; RSS FEED
      </a>
    </div>
  </section>

  <section class="flex flex-col gap-6">
    <div class="flex items-baseline justify-between">
      <h2
        class="font-display text-xs leading-relaxed text-cream-100 sm:text-sm sm:leading-relaxed"
      >
        RECENT POSTS
      </h2>
      <a
        href={withBase('/blog/')}
        class="font-terminal text-base uppercase text-muted transition-colors hover:text-sun"
      >
        view all &gt;
      </a>
    </div>

    {
      recent.length === 0 ? (
        <p class="font-terminal text-lg text-muted">NO POSTS YET.</p>
      ) : (
        <div class="flex flex-col gap-5">
          {recent.map((post, i) => (
            <PostCard post={post} index={i + 1} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

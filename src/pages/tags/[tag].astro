---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, tagSlug, type Post } from '../../lib/posts';

interface Props {
  tag: string;
  posts: Post[];
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
};

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`#${tag}`}
  description={`Posts tagged #${tag} on Atomic Burn Sauce.`}
>
  <section class="mb-10 flex flex-col gap-3">
    <p class="text-sm uppercase tracking-wide text-neutral-500">Tag</p>
    <h1 class="font-serif text-3xl font-semibold tracking-tight text-neutral-50">
      #{tag}
    </h1>
    <p class="text-neutral-400">
      {posts.length} {posts.length === 1 ? 'post' : 'posts'}
    </p>
  </section>

  <section class="flex flex-col gap-8">
    {posts.map((post) => <PostCard post={post} />)}
  </section>

  <div class="mt-10">
    <a
      href="/tags/"
      class="text-sm text-neutral-400 transition-colors hover:text-brand-400"
    >
      &larr; All tags
    </a>
  </div>
</BaseLayout>

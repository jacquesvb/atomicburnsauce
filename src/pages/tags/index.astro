---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, tagSlug } from '../../lib/posts';

const tags = await getAllTags();
---

<BaseLayout title="Tags" description="Browse posts by tag.">
  <section class="mb-10 flex flex-col gap-3">
    <h1 class="font-serif text-3xl font-semibold tracking-tight text-neutral-50">
      Tags
    </h1>
    <p class="text-neutral-400">
      {tags.length} tags across all published posts.
    </p>
  </section>

  {
    tags.length === 0 ? (
      <p class="text-neutral-500">No tags yet.</p>
    ) : (
      <ul class="flex flex-wrap gap-3">
        {tags.map(({ tag, count }) => (
          <li>
            <a
              href={`/tags/${tagSlug(tag)}/`}
              class="inline-flex items-center gap-2 rounded-full border border-neutral-700 bg-neutral-900 px-4 py-2 text-sm text-neutral-200 transition-colors hover:border-brand-500 hover:text-brand-400"
            >
              <span>#{tag}</span>
              <span class="text-xs text-neutral-500">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

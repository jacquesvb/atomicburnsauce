---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="Blog" description="All posts from AtomicBurnsauce.">
  <section class="mb-10 flex flex-col gap-3">
    <h1
      class="font-display text-lg leading-relaxed text-brand-400 glow-text sm:text-2xl sm:leading-relaxed"
    >
      BLOG
    </h1>
    <p class="font-terminal text-lg uppercase text-muted">
      {posts.length} posts in the cartridge stack
    </p>
  </section>

  <section class="flex flex-col gap-5">
    {
      posts.length === 0 ? (
        <p class="font-terminal text-lg text-muted">NO POSTS YET.</p>
      ) : (
        posts.map((post, i) => <PostCard post={post} index={i + 1} />)
      )
    }
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Blog"
  description="All posts from Atomic Burn Sauce."
>
  <section class="mb-10 flex flex-col gap-3">
    <h1 class="font-serif text-3xl font-semibold tracking-tight text-neutral-50">
      Blog
    </h1>
    <p class="text-neutral-400">{posts.length} posts and counting.</p>
  </section>

  <section class="flex flex-col gap-8">
    {
      posts.length === 0 ? (
        <p class="text-neutral-500">No posts yet.</p>
      ) : (
        posts.map((post) => <PostCard post={post} />)
      )
    }
  </section>
</BaseLayout>

---
import { tagSlug } from '../lib/posts';
import { withBase } from '../lib/urls';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <li>
          <a
            href={withBase(`/tags/${tagSlug(tag)}/`)}
            class="inline-block border-2 border-wood-600 bg-ink-900 px-2 py-0.5 font-terminal text-base uppercase leading-tight text-brand-300 transition-colors hover:border-sun hover:text-sun"
          >
            [{tag}]
          </a>
        </li>
      ))}
    </ul>
  )
}

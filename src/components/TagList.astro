---
import { tagSlug } from '../lib/posts';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <li>
          <a
            href={`/tags/${tagSlug(tag)}/`}
            class="inline-block rounded-full border border-neutral-700 bg-neutral-900 px-3 py-1 text-xs font-medium text-neutral-300 transition-colors hover:border-brand-500 hover:text-brand-400"
          >
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  )
}

---
import { Image } from 'astro:assets';
import type { Post } from '../lib/posts';
import { formatDate } from '../lib/posts';
import { withBase } from '../lib/urls';
import TagList from './TagList.astro';

interface Props {
  post: Post;
  index?: number;
}

const { post, index } = Astro.props;
const { title, description, pubDate, heroImage, heroImageAlt, tags } =
  post.data;
const href = withBase(`/blog/${post.id}/`);
const cart = index !== undefined ? String(index).padStart(2, '0') : null;
---

<article
  class={`group grid gap-4 border-2 border-wood-700 bg-ink-900 p-4 transition-colors hover:border-brand-600 ${
    heroImage ? 'sm:grid-cols-[9rem_1fr]' : ''
  }`}
>
  {
    heroImage && (
      <a href={href} class="pixel-frame block overflow-hidden">
        <Image
          src={heroImage}
          alt={heroImageAlt ?? ''}
          widths={[320, 640]}
          sizes="(min-width: 640px) 144px, 100vw"
          class="pixelated h-40 w-full object-cover sm:h-full"
          loading="lazy"
        />
      </a>
    )
  }

  <div class="flex flex-1 flex-col gap-3">
    <div
      class="flex items-center gap-3 font-terminal text-base uppercase text-muted"
    >
      {cart && <span class="text-sun">CART {cart}</span>}
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    </div>

    <h2
      class="font-display text-xs leading-relaxed text-cream-100 sm:text-sm sm:leading-relaxed"
    >
      <a href={href} class="transition-colors group-hover:text-sun">
        {title}
      </a>
    </h2>

    <p class="text-sm text-cream-300">{description}</p>

    <TagList tags={tags} />
  </div>
</article>

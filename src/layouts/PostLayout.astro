---
import { Image } from 'astro:assets';
import type { Post } from '../lib/posts';
import { formatDate, absoluteUrl } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import ShareLinks from '../components/ShareLinks.astro';

interface Props {
  post: Post;
  readingTime: number;
}

const { post, readingTime } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroImageAlt, tags } =
  post.data;

const postUrl = absoluteUrl(`/blog/${post.id}/`, Astro.site);
const ogImage = heroImage
  ? new URL(heroImage.src, Astro.site).toString()
  : undefined;
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  tags={tags}
>
  <article class="flex flex-col gap-8">
    <header class="flex flex-col gap-5">
      <h1
        class="font-display text-lg leading-relaxed text-brand-400 glow-text sm:text-2xl sm:leading-relaxed"
      >
        {title}
      </h1>

      <div
        class="font-terminal text-lg uppercase tracking-wide text-muted"
      >
        <span class="text-sun">DATE</span> {formatDate(pubDate)}
        <span class="mx-2 text-wood-500">//</span>
        <span class="text-sun">TIME</span> {readingTime} MIN
        {
          updatedDate && (
            <>
              <span class="mx-2 text-wood-500">//</span>
              <span class="text-sun">UPDATED</span> {formatDate(updatedDate)}
            </>
          )
        }
      </div>

      <TagList tags={tags} />
    </header>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt={heroImageAlt ?? ''}
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 768px, 100vw"
          class="pixel-frame pixelated w-full object-cover"
        />
      )
    }

    <ShareLinks url={postUrl} title={title} />

    <div class="pixel-frame bg-ink-900 p-5 sm:p-8">
      <div
        class="prose prose-invert prose-neutral max-w-none"
      >
        <slot />
      </div>
    </div>

    <footer class="border-t-2 border-wood-800 pt-6">
      <a
        href="/blog/"
        class="font-display text-[10px] uppercase tracking-widest text-muted transition-colors hover:text-sun"
      >
        &lt; BACK TO ALL POSTS
      </a>
    </footer>
  </article>
</BaseLayout>

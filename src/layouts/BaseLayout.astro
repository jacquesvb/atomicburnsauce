---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
}

const {
  title,
  description = 'Atomic Burn Sauce — notes, sounds, and moving pictures.',
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;

const siteName = 'Atomic Burn Sauce';
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href={new URL('rss.xml', Astro.site)}
    />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {
      ogImage && (
        <meta property="og:image" content={ogImage} />
      )
    }
    {
      type === 'article' && publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      type === 'article' && modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )
    }
    {
      type === 'article' &&
        tags.map((tag) => <meta property="article:tag" content={tag} />)
    }

    <meta
      name="twitter:card"
      content={ogImage ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    {
      ogImage && (
        <meta name="twitter:image" content={ogImage} />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-neutral-800/80">
      <nav
        class="mx-auto flex w-full max-w-3xl items-center justify-between px-5 py-4"
      >
        <a
          href="/"
          class="font-serif text-lg font-semibold tracking-tight text-neutral-50 transition-colors hover:text-brand-400"
        >
          Atomic Burn Sauce
        </a>
        <div class="flex items-center gap-5 text-sm text-neutral-400">
          <a class="transition-colors hover:text-brand-400" href="/blog/">Blog</a>
          <a class="transition-colors hover:text-brand-400" href="/tags/">Tags</a>
          <a class="transition-colors hover:text-brand-400" href="/rss.xml">RSS</a>
        </div>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-3xl flex-1 px-5 py-10">
      <slot />
    </main>

    <footer class="border-t border-neutral-800/80">
      <div
        class="mx-auto w-full max-w-3xl px-5 py-6 text-sm text-neutral-500"
      >
        <p>
          &copy; {new Date().getFullYear()} Atomic Burn Sauce. Built with
          <a
            class="underline decoration-neutral-700 underline-offset-4 transition-colors hover:text-brand-400"
            href="https://astro.build">Astro</a
          >.
        </p>
      </div>
    </footer>
  </body>
</html>
